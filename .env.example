# scarecrow-balancer environment — copy to .env (gitignored) and fill in.
# The running sunny-scarecrow container holds the live values; extract with:
#   sudo docker inspect sunny-scarecrow --format '{{range .Config.Env}}{{println .}}{{end}}'
FORK_BALANCER_TOKEN=evo-local
FORK_BALANCER_PORT=8486
FORK_PROBE_INTERVAL_S=1200
NVIDIA_API_KEY=nvapi-...your-nvidia-key...
OPENROUTER_API_KEY=sk-or-v1-...your-openrouter-key...
